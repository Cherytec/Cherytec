<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CheryTech</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
  <div class="logo">📱 CheryTech</div>

  <nav>
    <a href="#accueil">Accueil</a>
    <a href="#produits">Produits</a>
    <a href="#apropos">À propos</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section class="hero" id="accueil">
    <h1>La technologie à votre portée</h1>
    <p>Téléphones, ordinateurs, téléviseurs, électroménagers et bien plus.</p>

    <a class="btn" href="https://wa.me/18090000000">
      Commander sur WhatsApp
    </a>
</section>

<section id="produits">

<h2>Nos Produits</h2>

<div class="cards">

<div class="card">
<img src="assets/phone.jpg">
<h3>Smartphones</h3>
<p>Les meilleurs téléphones au meilleur prix.</p>
<button>Acheter</button>
</div>

<div class="card">
<img src="assets/laptop.jpg">
<h3>Laptops</h3>
<p>Pour le travail et les études.</p>
<button>Acheter</button>
</div>

<div class="card">
<img src="assets/tv.jpg">
<h3>Smart TV</h3>
<p>Images Ultra HD.</p>
<button>Acheter</button>
</div>

<div class="card">
<img src="assets/fridge.jpg">
<h3>Réfrigérateurs</h3>
<p>Qualité garantie.</p>
<button>Acheter</button>
</div>

</div>

</section>

<section id="apropos">

<h2>À propos de CheryTech</h2>

<p>
Nous proposons des produits électroniques de qualité
avec livraison rapide et excellent service client.
</p>

</section>

<footer id="contact">

<h3>Contact</h3>

<p>WhatsApp : +1 809 XXX XXXX</p>

<p>Email : contact@cherytech.com</p>

<p>© 2026 CheryTech</p>

</footer>

<script src="script.js"></script>

</body>
</html>
